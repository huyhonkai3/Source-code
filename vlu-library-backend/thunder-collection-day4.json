"requests": [
    {
    "_id": "review-approve-success",
    "name": "✅ Approve Document (Success)",
    "folderId": "review-document",
    "method": "PUT",
    "url": "{{base_url}}/api/admin/documents/{{pendingDocId}}/status",
    "headers": [
        {
        "name": "Authorization",
        "value": "Bearer {{adminAccessToken}}"
        },
        {
        "name": "Content-Type",
        "value": "application/json"
        }
    ],
    "body": {
        "type": "json",
        "raw": "{\n  \"status\": \"approved\"\n}"
    },
    "tests": [
        {
        "type": "res-code",
        "value": "200"
        },
        {
        "type": "json-query",
        "value": "$.data.document.status",
        "expected": "approved"
        }
    ]
    },
    {
    "_id": "review-reject-success",
    "name": "✅ Reject Document (Success)",
    "folderId": "review-document",
    "method": "PUT",
    "url": "{{base_url}}/api/admin/documents/{{pendingDocId2}}/status",
